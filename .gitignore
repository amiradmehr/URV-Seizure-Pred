# Virtual environments
.venv/
venv/
.venv-old/
venv-old/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Raw and generated EEG data
data/raw/
data/interim/
data/processed/

# On Unity, data/ is a symlink into a /scratch workspace. Never commit it;
# it would point at a path that does not exist on other machines.
/data

# Outputs are tracked, EXCEPT the regenerable bulk dumps: every one of these is
# 50-200 MB, they total ~4.5 GB, and GitHub rejects anything over 100 MB.
# Both are reproducible from the scripts that wrote them.
outputs/cv/*/out_of_fold_predictions.csv
outputs/analysis/*/cache.pkl

# SLURM job logs and the submitting session's job-ID record
logs/
.pipeline_jobids

# Local-only scripts and scratch work (not for the branch)
local/

# Editable-install metadata
*.egg-info/

# Large arrays
*.npy
*.npz

# IDE
.vscode/
.idea/

# Operating system
.DS_Store
Thumbs.db

# Editor backups of job scripts
slurm/*.bak

# SLURM job-id records written by the submitting session
.*_jobid
.*_jobids
